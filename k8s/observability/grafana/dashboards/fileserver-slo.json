{
  "uid": "fileserver-slo",
  "title": "FileServer SLI / SLO / SLA",
  "schemaVersion": 39,
  "version": 5,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "fileserver",
    "slo"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Login · успешность · 5 минут",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * ((sum(increase(fileserver_operations_total{job=\"fileserver-pods\",app=\"fileserver\",operation=\"login\",outcome=\"success\"}[5m]))) or (0 * sum(increase(fileserver_operations_total{job=\"fileserver-pods\",app=\"fileserver\",operation=\"login\",outcome=~\"success|failed\"}[5m])))) / (sum(increase(fileserver_operations_total{job=\"fileserver-pods\",app=\"fileserver\",operation=\"login\",outcome=~\"success|failed\"}[5m])) > 0)",
          "legendFormat": "SLI",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "vector(99)",
          "legendFormat": "SLO 99%",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "range": true
        },
        {
          "refId": "C",
          "expr": "vector(95)",
          "legendFormat": "SLA 95%",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "noValue": "No data",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "SLO 99%"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    6
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "SLA 95%"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    6
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "SLI"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Доля успешных login среди всех попыток. Ошибки 4xx/5xx учитываются. Окно каждой точки — 5 минут; пороги SLO/SLA заданы для 30 дней."
