{
  "uid": "fileserver-logs",
  "title": "FileServer logs",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "fileserver",
    "logs"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Application logs",
      "type": "logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 20,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "service.name:fileserver",
          "queryType": "instant",
          "editorMode": "code",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "showLogLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}
