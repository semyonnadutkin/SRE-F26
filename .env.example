# HTTP
APP_PORT=80
FILESERVER_PORT=8080
APP_ORIGIN=http://localhost

# PostgreSQL (setup generates a password and the matching connection URL)
POSTGRES_USER=fileserver
POSTGRES_PASSWORD=
POSTGRES_DB=fileserver
# Setup fills this URL; use an explicit connection URL for an external database.
DATABASE_URL=

# Object storage
S3_ENDPOINT=http://s3:8333
S3_REGION=us-east-1
S3_BUCKET=files
S3_ACCESS_KEY=fileserver
S3_SECRET_KEY=

# Authentication (Secure=false is only for local HTTP; durations use s, m, h)
COOKIE_SECURE=false
SESSION_TTL=168h

# Upload limits (bytes; 52428800 = 50 MiB)
MAX_FILE_BYTES=52428800
